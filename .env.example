# EduGenie Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=put_your_google_ai_studio_key_here

# Supported models: gemini-1.5-flash (recommended default, fast & high quota), gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Set to true if you have installed torch and transformers to run the local LaMini-Flan-T5-783M model.
# Set to false to use Google Gemini for concept explanations.
USE_LOCAL_EXPLAINER=false
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M

APP_ENV=development
CORS_ORIGINS=*
